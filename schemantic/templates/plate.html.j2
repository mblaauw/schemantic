{#- One template for every archetype: the body grid comes from layout.areas, or is derived from the archetype's layout. -#}
{%- macro icon(name, cls='ic', extra='') -%}
<svg class="{{ cls }}{{ extra }}" data-icon="{{ name }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">{{ icons(name) | safe }}</svg>
{%- endmacro -%}

{%- macro bullets(items) -%}
{%- for b in items %}<div class="li"><span class="dot"></span><span>{{ b }}</span></div>{% endfor -%}
{%- endmacro -%}

{%- macro tag(status) -%}
{%- if status %}<span class="tag tag-{{ status }}">{{ L.status[status] }}</span>{% endif -%}
{%- endmacro -%}

{%- macro card(c, cid) -%}
{%- set fl = flag_of.get(cid) -%}
<div class="card{% if c.status %} status-{{ c.status }}{% endif %}{% if c.focus %} focus{% endif %}" data-kind="card" data-id="{{ cid }}"{% if c.col %} style="grid-column: {{ c.col }}{% if c.span %} / span {{ c.span }}{% endif %}; grid-row: 1"{% elif c.row %} style="grid-row: {{ c.row }}"{% endif %}{% if c.layer %} data-layer="{{ c.layer }}"{% endif %}{% if c.refs %} data-refs="{{ c.refs | join(' | ') }}"{% endif %}{% if c.status == 'planned' %} data-dash{% endif %}>{{ icon(c.icon or 'box') }}<div class="ct"><div class="cn"><span{% if c.status == 'removed' %} data-strike{% endif %}>{{ c.name }}</span>{% if c.qualifier %} <span class="cq">({{ c.qualifier }})</span>{% endif %}{% if fl %}<span class="flag flag-{{ fl.kind }}">{{ fl.label }}</span>{% endif %}{% if c.status %} {{ tag(c.status) }}{% endif %}{% if c.assumed %} {{ tag('assumed') }}{% endif %}</div>
{%- if c.rating %}<div class="rating">{% for n in range(5) %}<span class="pip{% if n < c.rating %} on{% endif %}"></span>{% endfor %}</div>{% endif -%}
{%- if c.note %}<div class="cnote">{{ c.note }}</div>{% endif -%}
{%- if c.bullets %}<div class="cb">{{ bullets(c.bullets) }}</div>{% endif -%}
</div></div>
{%- endmacro -%}

{%- macro cards_block(p, flex='') -%}
<div class="blk cards{% if p.linked %} linked{% endif %}"{% if p.keep_grid %} data-keep{% endif %} style="grid-template-columns: {% if p.card_columns %}repeat({{ p.card_columns }}, minmax(0, 1fr)){% else %}repeat(auto-fit, minmax(min(var(--card-min), 100%), 1fr)){% endif %}{% if p.card_rows %}; grid-template-rows: repeat({{ p.card_rows }}, minmax(0, 1fr)){% endif %}{{ flex }}">
{%- if p.lifeline %}<div class="lifeline-line" style="grid-row: 1 / -1"></div>{% endif -%}
{%- if p.now %}<div class="now-cell" style="grid-column: {{ p.now }}; grid-row: 1"></div>{% endif -%}
{%- for c in p.cards %}{{ card(c, c.id or (p.id ~ '.card' ~ loop.index0)) }}{% endfor -%}
</div>
{%- endmacro -%}

{#- A pattern's caption, with what is assumed about it beside it. -#}
{%- macro pattern_head(pt) -%}
{%- if pt.caption or pt.assumed %}<div class="pt-head"><span class="pt-cap">{{ pt.caption or '' }}</span>{% if pt.assumed %}{{ tag('assumed') }}{% endif %}</div>{% endif -%}
{%- endmacro -%}

{%- macro pattern(pt, pid, i, flex='') -%}
{%- set bid = pid ~ '.' ~ pt.type ~ i -%}
{%- set st = (' style="' ~ flex[2:] ~ '"') if flex else '' -%}
{%- if pt.type == 'tier-strip' -%}
<div class="blk tier-strip" data-kind="pattern" data-id="{{ bid }}"{{ st | safe }}>
{{- pattern_head(pt) -}}
<div class="tiers">
{%- for t in pt.tiers -%}
<div class="tier tier-{{ t.tier }}" data-kind="tier" data-id="{{ bid }}.{{ loop.index0 }}">{{ icon(t.icon or 'database') }}<div><div class="tier-n">{{ t.name }}</div>{% if t.note %}<div class="tier-note">{{ t.note }}</div>{% endif %}</div></div>
{%- if not loop.last %}{{ icon('arrow-right', 'step-arrow') }}{% endif -%}
{%- endfor -%}
</div>
</div>
{%- elif pt.type == 'process-strip' -%}
<div class="blk steps" data-kind="pattern" data-id="{{ bid }}"{{ st | safe }}>
{{- pattern_head(pt) -}}
<div class="steps-row">
{%- for s in pt.steps -%}
<div class="step" data-kind="step" data-id="{{ bid }}.{{ loop.index0 }}"><span class="step-n">{{ loop.index }}</span>{% if s.icon %}{{ icon(s.icon) }}{% endif %}<div><div class="step-name">{{ s.name }}</div>{% if s.note %}<div class="step-note">{{ s.note }}</div>{% endif %}</div></div>
{%- if not loop.last %}{{ icon('arrow-right', 'step-arrow') }}{% endif -%}
{%- endfor -%}
</div>
</div>
{%- elif pt.type == 'tree' -%}
<div class="blk tree" data-kind="pattern" data-id="{{ bid }}"{{ st | safe }}>
{{- pattern_head(pt) -}}
{%- for row in tree_rows(pt.lines) -%}
<div class="trow" style="padding-left: {{ (row.depth - 1) * 14 if row.depth > 0 else 0 }}px">{% if row.depth > 0 %}<span class="tk"></span>{% endif %}<span>{{ row.text }}</span></div>
{%- endfor -%}
</div>
{%- elif pt.type == 'fields' -%}
<div class="blk fields" data-kind="pattern" data-id="{{ bid }}"{{ st | safe }}>
{{- pattern_head(pt) -}}
<div class="fd-grid">
{%- for f in pt.fields -%}
<div class="fd-mark">{% if f.key %}<span class="fd-key fd-{{ f.key }}">{{ L.fields[f.key] }}</span>{% endif %}</div>
<div class="fd-main"><div class="fd-name">{{ f.name }}</div>{% if f.note %}<div class="fd-note">{{ f.note }}</div>{% endif %}</div>
<div class="fd-type">{{ f.type or '' }}</div>
{%- endfor -%}
</div>
</div>
{%- elif pt.type == 'table' -%}
<div class="blk table" data-kind="pattern" data-id="{{ bid }}"{{ st | safe }}>
{{- pattern_head(pt) -}}
<div class="tb-grid" style="grid-template-columns: repeat({{ pt.columns | length }}, minmax(0, auto))">
{%- for col in pt.columns %}<div class="tb-col">{{ col }}</div>{% endfor -%}
{%- for r in pt.rows -%}{%- for v in r %}<div class="tb-cell{% if loop.first %} tb-first{% endif %}">{{ v }}</div>{% endfor -%}{%- endfor -%}
</div>
</div>
{%- elif pt.type == 'metric' -%}
<div class="blk metrics" data-kind="pattern" data-id="{{ bid }}"{{ st | safe }}>
{{- pattern_head(pt) -}}
<div class="mt-row">
{%- for m in pt.metrics %}<div class="metric"><div class="mt-value">{{ m.value }}</div><div class="mt-label">{{ m.label }}</div>{% if m.note %}<div class="mt-note">{{ m.note }}</div>{% endif %}</div>{% endfor -%}
</div>
</div>
{%- elif pt.type == 'matrix' -%}
<div class="blk matrix" data-kind="pattern" data-id="{{ bid }}"{{ st | safe }}>
{{- pattern_head(pt) -}}
<div class="mx-grid" style="grid-template-columns: max-content repeat({{ pt.columns | length }}, minmax(72px, max-content))"><span></span>
{%- for col in pt.columns %}<div class="mx-col">{{ col }}</div>{% endfor -%}
{%- for r in pt.rows -%}<div class="mx-row">{{ r.name }}</div>
{%- for v in r.cells %}<div class="mx-cell"><span class="mx-{{ v }}"></span></div>{% endfor -%}
{%- endfor -%}
</div>
<div class="mx-key">{% for v in matrix_values(pt) %}<div class="mx-key-item"><span class="mx-{{ v }}"></span><span>{{ (pt.key or {}).get(v) or L.matrix[v] }}</span></div>{% endfor %}</div>
</div>
{%- endif -%}
{%- endmacro -%}

{#- A zone of a nested-zones plate: a dashed frame with a label, holding zones and panels; up to three levels. -#}
{%- macro zone(z, depth) -%}
<section class="zone zone-{{ depth }}{% if z.zones %} has-zones{% endif %}" data-kind="zone" data-id="zone.{{ z.id }}" data-dash>
<div class="zone-label">{% if z.kind %}<span class="zone-kind">{{ z.kind }}</span>{% endif %}<span>{{ z.title }}</span></div>
<div class="zone-body">
{%- for child in z.zones or [] %}{{ zone(child, depth + 1) }}{% endfor -%}
{%- for pid in z.panels or [] %}{{ panel(panel_by_id[pid]) }}{% endfor -%}
</div>
</section>
{%- endmacro -%}

{%- macro panel(p) -%}
<section class="panel role-{{ p.role }}{% if p.lane %} lane{% endif %}{% if p.lifeline %} lifeline{% endif %}{% if p.cell %} cell{% endif %}{% if p.hub %} panel-hub{% endif %}{% if p.status %} status-{{ p.status }}{% endif %}{% if p.focus %} focus{% endif %}{% if p.quiet %} quiet{% endif %}{% if p.spread %} spread{% endif %}" data-kind="panel" data-id="{{ p.id }}"{% if not p.nested %} style="grid-area: {{ p.id }}"{% endif %}{% if p.status == 'planned' %} data-dash{% endif %}>
<div class="ph"><div class="ph-row"><div class="ph-title">{{ p.title }}</div>{{ tag(p.mark) }}{{ tag(p.status) }}{% if p.assumed %}{{ tag('assumed') }}{% endif %}</div>{% if p.subtitle %}<div class="ph-sub">{{ p.subtitle }}</div>{% endif %}</div>
<div class="pb">
<div class="blocks arrange-{{ p.arrange or 'column' }}">
{#- In a row, blocks share the width by `weights` (patterns first, then cards). -#}
{%- set w = p.weights or [] -%}
{%- set npat = (p.patterns or []) | length -%}
{%- if (p.arrange or 'column') == 'column' and p.cards %}{{ cards_block(p) }}{% endif -%}
{%- for pt in p.patterns or [] %}{{ pattern(pt, p.id, loop.index0, ('; flex: ' ~ w[loop.index0] ~ ' 1 0') if p.arrange == 'row' and w | length > loop.index0 else '') }}{% endfor -%}
{%- if p.arrange == 'row' and p.cards %}{{ cards_block(p, ('; flex: ' ~ w[npat] ~ ' 1 0') if w | length > npat else '') }}{% endif -%}
</div>
{%- if p.becomes %}<div class="becomes">{{ icon('chevron-right') }}</div>{% endif -%}
{%- if p.chips -%}
<div class="chips{% if p.chips_bottom %} chips-bottom{% endif %}">{% for ch in p.chips %}{% set ql = question_at.get(p.id ~ '.chip' ~ loop.index0) %}<div class="chip chip-{{ ch.kind }}" data-kind="chip" data-id="{{ p.id }}.chip{{ loop.index0 }}">{% if ql %}<span class="flag flag-warning">{{ ql }}</span>{% else %}{{ icon('alert-triangle' if ch.kind == 'warning' else 'info-circle') }}{% endif %}<div>{{ ch.text }}</div></div>{% endfor %}</div>
{%- endif -%}
</div>
</section>
{%- endmacro -%}

<!doctype html>
<html lang="{{ lang }}"><head><meta charset="utf-8"><title>{{ spec.title }}</title>
<style>{{ css | safe }}
#body { grid-template-columns: {{ grid.columns }}; grid-template-rows: {{ grid.rows }}; grid-template-areas: {{ grid.areas | safe }}; margin-bottom: {{ grid.room_below }}; }
.footer { grid-template-columns: {{ footer_columns }}; }
</style></head>
<body>
<div id="plate" style="width: {{ width }}px; height: {{ height }}px">
<header class="titleblock" data-kind="titleblock" data-id="titleblock">
<div>{% if spec.topic %}<p class="topic">{{ spec.topic }}</p>{% endif %}<h1 class="title">{{ spec.title }}</h1>{% if spec.subtitle %}<p class="subtitle">{{ spec.subtitle }}</p>{% endif %}</div>
{%- if badge %}<div class="badge">{{ badge }}</div>{% endif -%}
</header>
<main class="body" id="body" data-kind="body" data-id="body"{% if grid.open_cells %} data-open-cells{% endif %}>
{%- for p in panels if not p.nested %}{{ panel(p) }}{% endfor -%}
{%- for g, ids in grid.groups.items() -%}
{%- set kind = grid.group_kind.get(g, 'row') -%}
{%- if kind == 'zones' -%}
<div class="zones" style="grid-area: {{ g }}">{% for z in grid.zones %}{{ zone(z, 1) }}{% endfor %}</div>
{%- elif kind == 'stack' -%}
<div class="stack" style="grid-area: {{ g }}">{% for pid in ids %}{{ panel(panel_by_id[pid]) }}{% endfor %}</div>
{%- else -%}
<div class="spoke-row" style="grid-area: {{ g }}; grid-template-columns: repeat({{ ids | length }}, minmax(0, 1fr))">
{%- for pid in ids %}{{ panel(panel_by_id[pid]) }}{% endfor -%}
</div>
{%- endif -%}
{%- endfor -%}
{%- for b, labels in grid.bands.items() -%}
<div class="band band-{{ b[1:] }}" data-kind="band" data-id="band.{{ b[1:] }}" style="grid-area: {{ b }}; grid-template-columns: repeat({{ labels | length }}, minmax(0, 1fr))">
{%- for label in labels %}{% set now = grid.marks.get(b) == loop.index %}<div class="band-label{% if now %} now{% endif %}">{{ label }}{% if now %} <span class="now-tag">{{ L[grid.mark_label] }}</span>{% endif %}</div>{% endfor -%}
</div>
{%- endfor -%}
</main>
{%- macro footer_section(name) -%}
{%- if name == 'context' -%}
<section class="panel role-frame" data-kind="panel" data-id="footer.context"><div class="ph"><div class="ph-title">{{ footer.context.title }}</div></div>
<div class="pb">{{ cards_block({'id': 'footer.context', 'cards': footer.context.cards, 'card_columns': footer.context.card_columns or 2}) }}</div></section>
{%- elif name == 'principles' -%}
<section class="panel role-frame" data-kind="panel" data-id="footer.principles"><div class="ph"><div class="ph-title">{{ L.footer.principles }}</div></div>
<div class="pb">{{ bullets(footer.principles) }}</div></section>
{%- elif name == 'open_questions' -%}
<section class="panel role-frame" data-kind="panel" data-id="footer.open_questions"><div class="ph"><div class="ph-title">{{ L.footer.open_questions }}</div></div>
<div class="pb">{% for q in open_questions %}<div class="oq"><span class="flag flag-warning">{{ q.label }}</span><span>{{ q.text }}</span></div>{% endfor %}</div></section>
{%- elif name == 'notes' -%}
<section class="panel role-frame" data-kind="panel" data-id="footer.notes"><div class="ph"><div class="ph-title">{{ L.footer.notes }}</div></div>
<div class="pb">{% for q in notes %}<div class="note"><span class="flag flag-info">{{ q.label }}</span><span>{{ q.text }}</span></div>{% endfor %}</div></section>
{%- elif name == 'legend' -%}
<section class="panel role-frame" data-kind="panel" data-id="footer.legend"><div class="ph"><div class="ph-title">{{ L.footer.legend }}</div></div>
<div class="pb">
{%- for e in legend -%}
{%- if e.kind == 'role' %}<div class="lg"><span class="sw" style="background: var(--{{ e.key }}-sub); border: 1.5px solid var(--{{ e.key }}-head)"></span><span>{{ e.label }}</span></div>
{%- elif e.kind == 'arrow' %}<div class="lg">{{ icon('arrow-right', 'ic', ' lg-arrow') }}<span>{{ e.label }}</span></div>
{%- elif e.kind == 'line' %}<div class="lg"><span class="ls" data-line="{{ e.key }}"></span><span>{{ e.label }}</span></div>
{%- elif e.kind == 'step' %}<div class="lg"><span class="flag flag-step">1</span><span>{{ e.label }}</span></div>
{%- elif e.kind == 'status' %}<div class="lg">{{ tag(e.key) }}<span>{{ e.label }}</span></div>
{%- elif e.kind == 'field-key' %}<div class="lg"><span class="fd-key fd-{{ e.key }}">{{ L.fields[e.key] }}</span><span>{{ e.label }}</span></div>
{%- elif e.kind == 'rating' %}<div class="lg"><span class="rating"><span class="pip on"></span><span class="pip on"></span><span class="pip"></span></span><span>{{ e.label }}</span></div>
{%- elif e.kind == 'focus' %}<div class="lg"><span class="sw focus-sw"></span><span>{{ e.label }}</span></div>
{%- elif e.key == 'warning' and open_questions %}<div class="lg"><span class="flag flag-warning">{{ open_questions[0].label }}</span><span>{{ e.label }}</span></div>
{%- else %}<div class="lg">{{ icon('alert-triangle' if e.key == 'warning' else 'info-circle', 'ic', ' lg-' ~ e.key) }}<span>{{ e.label }}</span></div>{% endif -%}
{%- endfor -%}
</div></section>
{%- endif -%}
{%- endmacro -%}
<footer class="footer" data-kind="footer" data-id="footer">
{%- for col in footer_layout if col != ['legend'] -%}
<div class="fcol">{% for name in col %}{{ footer_section(name) }}{% endfor %}</div>
{%- endfor -%}
{%- if legend %}<div class="fcol legend-strip">{{ footer_section('legend') }}</div>{% endif -%}
</footer>
</div>
</body></html>
