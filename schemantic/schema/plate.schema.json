{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mblaauw/schemantic/schemantic/schema/plate.schema.json",
  "title": "Schemantic plate spec",
  "description": "A one-page architecture plate: what is on it, never where. Chromium lays it out; lint checks the result.",
  "type": "object",
  "required": [
    "canvas",
    "title",
    "archetype",
    "layout",
    "panels"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": 1,
      "description": "Version of this spec format. Optional; 1 is the current version."
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "description": "The plan behind the plate, written before the YAML and audited against the sources. Not rendered.",
      "properties": {
        "message": {
          "type": "string",
          "description": "The one claim the plate makes."
        },
        "reader": {
          "type": "string",
          "description": "Who reads it and what they must take away."
        },
        "why": {
          "type": "string",
          "description": "Why this archetype, and what it is not."
        },
        "left_out": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What the sources hold that the plate leaves out, and why."
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What is assumed rather than found in a source."
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "Where the content comes from. When given, every card, arrow, status and warning names its source, or says it is assumed (lint: traceability).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "The source on disk, relative to the spec: a file, or a folder of files. Lint then checks that each ref's quote is really there."
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "kind": {
            "enum": [
              "conversation",
              "notes",
              "document",
              "repository",
              "process",
              "other"
            ]
          },
          "ref": {
            "type": "string",
            "description": "A path, title or URL."
          }
        }
      }
    },
    "canvas": {
      "type": "object",
      "description": "Page size, language and series badge.",
      "required": [
        "size",
        "lang"
      ],
      "additionalProperties": false,
      "properties": {
        "size": {
          "enum": [
            "landscape-4x3",
            "landscape-16x9",
            "a3-landscape",
            "a4-landscape"
          ],
          "description": "landscape-4x3 is 1600 px wide (the default choice); landscape-16x9 is 1920 x 1080, for slides; a3-landscape and a4-landscape are the paper sizes at 96 px per inch (the plate takes its content height and is centred on the sheet); --dpi sets the PNG resolution."
        },
        "lang": {
          "enum": [
            "nl",
            "en"
          ],
          "description": "Language of the fixed labels; follow the user. In nl, technical terms stay English."
        },
        "series": {
          "type": "string",
          "description": "Name of the series this plate belongs to."
        },
        "part": {
          "type": "integer",
          "minimum": 1,
          "description": "This plate's number in the series; give `of` too."
        },
        "of": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of plates in the series; give `part` too."
        },
        "theme": {
          "type": "string",
          "description": "A CSS file, relative to the spec, appended after tokens.css: override colours, add roles. Lint still checks contrast."
        },
        "height": {
          "enum": [
            "fit",
            "fixed"
          ],
          "description": "fit (default): the canvas takes its content height (at least 9:16 of the width). fixed: the preset height; surplus space goes to the gaps between rows, never into a panel."
        },
        "profile": {
          "enum": [
            "document",
            "slide"
          ],
          "description": "document (default): read up close, on screen or paper. slide: shown in a meeting; a larger type ramp, a higher type floor, and fewer panels and cards."
        }
      }
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "What the plate is about, in a few words (a system, a phase): a quiet line above the title, so the title can be the claim."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "The one message, as a claim."
    },
    "subtitle": {
      "type": "string",
      "maxLength": 120,
      "description": "How the plate makes the title's claim true."
    },
    "archetype": {
      "enum": [
        "column-flow",
        "hub-and-spokes",
        "layer-cake",
        "nested-zones",
        "swimlane",
        "before-after",
        "roadmap",
        "sequence",
        "capability-map",
        "comparison",
        "hierarchy",
        "quadrant"
      ],
      "description": "The body layout; references/archetypes.md says when to use each."
    },
    "layout": {
      "type": "object",
      "description": "Where panels go, in terms of the archetype. Which keys apply depends on the archetype.",
      "additionalProperties": false,
      "properties": {
        "areas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string"
          },
          "description": "column-flow: rows of panel ids, like CSS grid-template-areas; '.' is empty; a panel spans a rectangle."
        },
        "column_widths": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "column-flow: relative column widths, one per column."
        },
        "hub": {
          "type": "string",
          "description": "hub-and-spokes: the central panel's id."
        },
        "top": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string"
          },
          "description": "hub-and-spokes: spoke ids above the hub, left to right."
        },
        "bottom": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string"
          },
          "description": "hub-and-spokes: spoke ids below the hub, left to right."
        },
        "layers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string"
          },
          "description": "layer-cake: layer ids, top first."
        },
        "left": {
          "type": "string",
          "description": "hub-and-spokes: a side spoke; layer-cake: a rail spanning every layer."
        },
        "right": {
          "type": "string",
          "description": "hub-and-spokes: a side spoke; layer-cake: a rail spanning every layer."
        },
        "chips_at": {
          "enum": [
            "content",
            "bottom"
          ],
          "description": "content (default): chips sit right under the panel's content. bottom: pinned to the panel's bottom, in rows where every panel has chips."
        },
        "rail_width": {
          "enum": [
            "narrow",
            "normal",
            "wide"
          ],
          "description": "layer-cake: width of the rails, between 260 px (at 1600 wide) and 30% of the body. normal is the default."
        },
        "participants": {
          "type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "string"},
          "description": "sequence: participant (panel) ids, left to right; each is a lifeline."
        },
        "domains": {
          "type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "string"},
          "description": "capability-map: domain (panel) ids, top first; a domain's cards are its capabilities."
        },
        "per_row": {
          "type": "integer", "minimum": 2, "maximum": 8,
          "description": "capability-map: columns that line up down the plate; without it, each domain's cards share its row's width."
        },
        "criteria": {
          "type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "string"},
          "description": "comparison: criterion (panel) ids, top first; a criterion has one card per option."
        },
        "options": {
          "type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string"},
          "description": "comparison: the options' names, the column labels."
        },
        "pick": {
          "type": "integer", "minimum": 1,
          "description": "comparison: the option recommended (1 is the first), marked and tinted."
        },
        "root": {
          "type": "string",
          "description": "hierarchy: the panel at the top of the tree."
        },
        "children": {
          "type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "description": "hierarchy: panel id -> the panels directly under it; the arrows follow from this."
        },
        "cells": {
          "type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"},
          "description": "quadrant: the four panels, left to right, top row first."
        },
        "x": {
          "type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"},
          "description": "quadrant: the labels over the left and right columns."
        },
        "y": {
          "type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"},
          "description": "quadrant: the labels beside the top and bottom rows."
        },
        "lanes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "string"
          },
          "description": "swimlane: lane (panel) ids, top first; a lane's cards are its steps. roadmap: one lane per workstream; its cards are items."
        },
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 32
          },
          "description": "swimlane: phase names over the step columns. roadmap: the periods. A card's col places it in one."
        },
        "zones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/zone"
          },
          "description": "nested-zones: the top-level zones, side by side; up to three levels deep."
        },
        "outside": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "nested-zones: panels outside every zone, in a column on the right."
        },
        "outside_at": {
          "type": "string",
          "enum": ["right", "bottom"],
          "description": "nested-zones: where the outside panels stand. bottom: in a row under the zones, when one or two short panels would float beside tall zones; a zone that holds zones then takes its parent's whole width."
        },
        "before": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string"
          },
          "description": "before-after: panel ids as things are, top first. The panel at the same place in `after` faces it."
        },
        "after": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string"
          },
          "description": "before-after: panel ids as they will be; show what changed with status (new, changed, removed)."
        },
        "labels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "maxLength": 32
          },
          "description": "before-after: the two column labels (default Before / After, in Dutch Nu / Straks)."
        },
        "now": {
          "type": "integer",
          "minimum": 1,
          "description": "roadmap: the current period (1 is the first column), marked in the band."
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/panel"
      },
      "description": "The boxes on the plate."
    },
    "flows": {
      "type": "array",
      "description": "Connectors between panels or cards; the router draws them around every box.",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Where this comes from: '<source id>: <path, line or short quote>'. Not rendered."
          },
          "assumed": {
            "type": "string",
            "maxLength": 160,
            "description": "The sources do not say this; why it is drawn anyway. The plate marks it, so a reader can tell it from a fact. Not rendered."
          },
          "from": {
            "type": "string",
            "description": "A panel id or card id."
          },
          "to": {
            "type": "string",
            "description": "A panel id or card id."
          },
          "label": {
            "type": "string",
            "maxLength": 28,
            "description": "Short label beside the arrow; needs a run with room."
          },
          "both": {
            "type": "boolean",
            "description": "Arrowheads at both ends."
          },
          "style": {
            "enum": [
              "sync",
              "async",
              "optional"
            ],
            "description": "sync: solid (default); async: dashed (event or message); optional: dotted."
          },
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "A numbered badge on the arrow, for the order things happen."
          },
          "focus": {
            "type": "boolean",
            "description": "The one arrow the plate is about: drawn heavier, in the accent colour (one focus per plate)."
          }
        }
      }
    },
    "flows_mean": {
      "enum": [
        "data",
        "request",
        "dependency",
        "control",
        "sequence"
      ],
      "description": "What every arrow on this plate means; sets the legend label. data: where data goes; request: who calls whom; dependency: what needs what; control: what steers what; sequence: what comes before what (a roadmap's arrows, forward in time)."
    },
    "stories": {
      "type": "array",
      "maxItems": 4,
      "description": "The routes the title or subtitle tells, step by step. Lint checks that a flow joins every step to the next, so a reader can follow the route with a finger; `draw: true` numbers one of them on the plate.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "description": "The route in the reader's words, as the title or subtitle says it."
          },
          "path": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "items": {
              "type": "string"
            },
            "description": "Card or panel ids, first to last; a flow must run from each to the next."
          },
          "draw": {
            "type": "boolean",
            "description": "Number the route on the plate: its flows get step badges 1 to n, and the legend names the story. One drawn story per plate; its flows take no step of their own."
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "description": "Context, principles, open questions and the legend, under the body.",
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "Relative widths, one per footer panel present. Optional."
        },
        "context": {
          "type": "object",
          "required": [
            "title",
            "cards"
          ],
          "additionalProperties": false,
          "description": "People or roles around the system.",
          "properties": {
            "title": {
              "type": "string"
            },
            "card_columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "cards": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "$ref": "#/$defs/card"
              }
            }
          }
        },
        "principles": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          },
          "description": "Decisions, each a full sentence a team could check."
        },
        "open_questions": {
          "type": "object",
          "additionalProperties": false,
          "description": "Open questions: warning chips (from_chips) plus extra ones.",
          "properties": {
            "from_chips": {
              "type": "boolean"
            },
            "extra": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "legend": {
          "const": "auto",
          "description": "The legend is generated from what the plate uses."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "column-flow"
          }
        },
        "required": [
          "archetype"
        ]
      },
      "then": {
        "properties": {
          "layout": {
            "required": [
              "areas"
            ],
            "propertyNames": {
              "enum": [
                "areas",
                "column_widths",
                "chips_at"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "hub-and-spokes"
          }
        },
        "required": [
          "archetype"
        ]
      },
      "then": {
        "properties": {
          "layout": {
            "required": [
              "hub"
            ],
            "propertyNames": {
              "enum": [
                "hub",
                "top",
                "bottom",
                "left",
                "right",
                "chips_at"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "layer-cake"
          }
        },
        "required": [
          "archetype"
        ]
      },
      "then": {
        "properties": {
          "layout": {
            "required": [
              "layers"
            ],
            "propertyNames": {
              "enum": [
                "layers",
                "left",
                "right",
                "chips_at",
                "rail_width"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "swimlane"
          }
        },
        "required": [
          "archetype"
        ]
      },
      "then": {
        "properties": {
          "layout": {
            "required": [
              "lanes"
            ],
            "propertyNames": {
              "enum": [
                "lanes",
                "columns",
                "chips_at"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "nested-zones"
          }
        },
        "required": [
          "archetype"
        ]
      },
      "then": {
        "properties": {
          "layout": {
            "required": [
              "zones"
            ],
            "propertyNames": {
              "enum": [
                "zones",
                "outside",
                "outside_at",
                "chips_at"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "before-after"
          }
        },
        "required": [
          "archetype"
        ]
      },
      "then": {
        "properties": {
          "layout": {
            "required": [
              "before",
              "after"
            ],
            "propertyNames": {
              "enum": [
                "before",
                "after",
                "labels",
                "chips_at"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "roadmap"
          }
        },
        "required": [
          "archetype"
        ]
      },
      "then": {
        "properties": {
          "layout": {
            "required": [
              "lanes",
              "columns"
            ],
            "propertyNames": {
              "enum": [
                "lanes",
                "columns",
                "now",
                "chips_at"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "sequence"
          }
        },
        "required": [
          "archetype"
        ]
      },
      "then": {
        "properties": {
          "layout": {
            "required": ["participants"],
            "propertyNames": {
              "enum": ["participants", "chips_at"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "capability-map"
          }
        },
        "required": [
          "archetype"
        ]
      },
      "then": {
        "properties": {
          "layout": {
            "required": ["domains"],
            "propertyNames": {
              "enum": ["domains", "per_row", "chips_at"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "comparison"
          }
        },
        "required": [
          "archetype"
        ]
      },
      "then": {
        "properties": {
          "layout": {
            "required": ["criteria", "options"],
            "propertyNames": {
              "enum": ["criteria", "options", "pick", "chips_at"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "hierarchy"
          }
        },
        "required": [
          "archetype"
        ]
      },
      "then": {
        "properties": {
          "layout": {
            "required": ["root", "children"],
            "propertyNames": {
              "enum": ["root", "children", "chips_at"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "quadrant"
          }
        },
        "required": [
          "archetype"
        ]
      },
      "then": {
        "properties": {
          "layout": {
            "required": ["cells", "x", "y"],
            "propertyNames": {
              "enum": ["cells", "x", "y", "chips_at"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "card": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "A thing with a name inside a panel.",
      "properties": {
        "assumed": {
          "type": "string",
          "maxLength": 160,
          "description": "The sources do not say this; why it is drawn anyway. The plate marks it, so a reader can tell it from a fact. Not rendered."
        },
        "status_ref": {
          "type": "string",
          "description": "Where the sources give this status: '<source id>: <path, line or short quote>'. Not rendered."
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Needed only when a flow starts or ends at this card."
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "name": {
          "type": "string",
          "maxLength": 40,
          "description": "A noun the reader knows."
        },
        "qualifier": {
          "type": "string",
          "maxLength": 40,
          "description": "Shown in brackets after the name."
        },
        "note": {
          "type": "string",
          "maxLength": 70,
          "description": "What the card does in this story; lowercase start, no full stop."
        },
        "bullets": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 60
          }
        },
        "status": {
          "enum": [
            "new",
            "changed",
            "planned",
            "deprecated",
            "removed"
          ],
          "description": "Change in this phase: a tag in the corner; planned is dashed, deprecated muted, removed struck through."
        },
        "focus": {
          "type": "boolean",
          "description": "The one element the plate is about: an accent outline. At most one per plate."
        },
        "flag": {
          "type": "object",
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false,
          "description": "A numbered marker on the card; the text goes to the footer under the same number (warning: open questions; info: notes).",
          "properties": {
            "refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Where this comes from: '<source id>: <path, line or short quote>'. Not rendered."
            },
            "kind": {
              "enum": [
                "warning",
                "info"
              ]
            },
            "text": {
              "type": "string",
              "maxLength": 90
            }
          }
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Where this card comes from: '<source id>: <path, line or short quote>'. Not rendered; written to the SVG as data-refs."
        },
        "col": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "swimlane: the step column (1 is the first phase) this card sits in."
        },
        "row": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "sequence: the moment this card acts, 1 is the first; a message joins two cards in one row."
        },
        "layer": {
          "type": "string",
          "description": "layer-cake, a card in a rail: the layer it concerns. The card sits level with that layer's cards."
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "roadmap: the number of periods an item runs over, from its col (default 1)."
        }
      }
    },
    "chip": {
      "type": "object",
      "required": [
        "kind",
        "text"
      ],
      "additionalProperties": false,
      "description": "A warning (open choice, repeated under open questions) or info (assumption) note in a panel.",
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Where this comes from: '<source id>: <path, line or short quote>'. Not rendered."
        },
        "kind": {
          "enum": [
            "warning",
            "info"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 90
        }
      }
    },
    "pattern": {
      "type": "object",
      "required": [
        "type"
      ],
      "description": "A structured block inside a panel: tier strip, process strip, tree or matrix.",
      "properties": {
        "type": {
          "enum": [
            "tier-strip",
            "tree",
            "matrix",
            "process-strip"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "tier-strip"
              }
            }
          },
          "then": {
            "required": [
              "tiers"
            ],
            "properties": {
              "tiers": {
                "type": "array",
                "minItems": 2,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "required": [
                    "tier",
                    "name"
                  ],
                  "properties": {
                    "tier": {
                      "enum": [
                        "bronze",
                        "silver",
                        "gold"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "icon": {
                      "$ref": "#/$defs/icon"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tree"
              }
            }
          },
          "then": {
            "required": [
              "lines"
            ],
            "properties": {
              "caption": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "matrix"
              }
            }
          },
          "then": {
            "required": [
              "columns",
              "rows"
            ],
            "properties": {
              "caption": {
                "type": "string"
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "cells"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "cells": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "full",
                          "partial",
                          "none"
                        ]
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "key": {
                "type": "object",
                "additionalProperties": false,
                "description": "Labels for the key, when the locale's (full, limited, no access) do not fit what the matrix shows.",
                "properties": {
                  "full": {
                    "type": "string",
                    "maxLength": 24
                  },
                  "partial": {
                    "type": "string",
                    "maxLength": 24
                  },
                  "none": {
                    "type": "string",
                    "maxLength": 24
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "process-strip"
              }
            }
          },
          "then": {
            "required": [
              "steps"
            ],
            "properties": {
              "caption": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "minItems": 3,
                "maxItems": 7,
                "description": "Steps in order, left to right.",
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 24
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "icon": {
                      "$ref": "#/$defs/icon"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "panel": {
      "type": "object",
      "required": [
        "id",
        "title",
        "role"
      ],
      "additionalProperties": false,
      "description": "A box on the plate holding cards, patterns and chips.",
      "properties": {
        "assumed": {
          "type": "string",
          "maxLength": 160,
          "description": "The sources do not say this; why it is drawn anyway. The plate marks it, so a reader can tell it from a fact. Not rendered."
        },
        "status_ref": {
          "type": "string",
          "description": "Where the sources give this status: '<source id>: <path, line or short quote>'. Not rendered."
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Used in layout and flows."
        },
        "title": {
          "type": "string",
          "maxLength": 48
        },
        "subtitle": {
          "type": "string",
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Colour with a meaning, shown in the legend. Built in: platform (what the team builds or runs), data (data at rest, data platforms), external (systems outside the team's control), actor (people and teams). A theme can add roles."
        },
        "arrange": {
          "enum": [
            "column",
            "row"
          ],
          "description": "row: blocks side by side instead of stacked."
        },
        "weights": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "With arrange: row, relative widths: patterns first, then the cards block."
        },
        "card_columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "description": "Columns for the panel's cards. Without it, the cards take as many columns of at least 280 px as the panel's width fits."
        },
        "cards": {
          "type": "array",
          "maxItems": 12,
          "description": "At most 6; a sequence's lifeline, which has one per moment, 12.",
          "items": {
            "$ref": "#/$defs/card"
          }
        },
        "patterns": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/pattern"
          }
        },
        "chips": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/chip"
          }
        },
        "status": {
          "enum": [
            "new",
            "changed",
            "planned",
            "deprecated",
            "removed"
          ],
          "description": "Change in this phase: a tag in the corner; planned is dashed, deprecated muted, removed struck through."
        },
        "focus": {
          "type": "boolean",
          "description": "The one element the plate is about: an accent outline. At most one per plate."
        }
      }
    },
    "zone": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "description": "A labelled frame: an environment, account, cluster or namespace. Holds zones, panels, or both.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "maxLength": 40
        },
        "kind": {
          "type": "string",
          "maxLength": 24,
          "description": "What the zone is, shown before the title: account, cluster, namespace."
        },
        "zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/zone"
          }
        },
        "panels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "An icon name from the bundled set (`schemantic icons <word>`): lowercase words joined by hyphens."
    }
  }
}
