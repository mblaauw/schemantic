{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture plate spec",
  "type": "object",
  "required": ["canvas", "title", "archetype", "layout", "panels"],
  "additionalProperties": false,
  "properties": {
    "canvas": {
      "type": "object",
      "required": ["size", "lang"],
      "additionalProperties": false,
      "properties": {
        "size": {"enum": ["landscape-4x3", "landscape-16x9"]},
        "lang": {"enum": ["nl", "en"]},
        "series": {"type": "string"},
        "part": {"type": "integer", "minimum": 1},
        "of": {"type": "integer", "minimum": 1}
      }
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "subtitle": {"type": "string", "maxLength": 120},
    "archetype": {"enum": ["column-flow", "hub-and-spokes", "banded-matrix", "layer-cake", "nested-zones",
                           "swimlane", "before-after", "roadmap", "landscape-map"]},
    "layout": {
      "$comment": "Which keys apply depends on the archetype; semantic checks enforce that (platelib.LAYOUT_KEYS).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "areas": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
        "column_widths": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}},
        "row_heights": {"type": "array", "items": {"enum": ["fill", "auto"]}},
        "hub": {"type": "string"},
        "top": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
        "bottom": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
        "layers": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string"}},
        "left": {"type": "string"},
        "right": {"type": "string"}
      }
    },
    "panels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/panel"}},
    "flows": {
      "type": "array",
      "items": {
        "type": "object", "required": ["from", "to"], "additionalProperties": false,
        "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "label": {"type": "string", "maxLength": 28},
                       "both": {"type": "boolean"}}
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "columns": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}},
        "context": {
          "type": "object", "required": ["title", "cards"], "additionalProperties": false,
          "properties": {"title": {"type": "string"}, "card_columns": {"type": "integer", "minimum": 1, "maximum": 4},
                         "cards": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/card"}}}
        },
        "principles": {"type": "array", "maxItems": 5, "items": {"type": "string"}},
        "open_questions": {
          "type": "object", "additionalProperties": false,
          "properties": {"from_chips": {"type": "boolean"}, "extra": {"type": "array", "items": {"type": "string"}}}
        },
        "legend": {"const": "auto"}
      }
    }
  },
  "$defs": {
    "card": {
      "type": "object", "required": ["name"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}, "icon": {"type": "string"},
        "name": {"type": "string", "maxLength": 40}, "qualifier": {"type": "string", "maxLength": 40},
        "note": {"type": "string", "maxLength": 70},
        "bullets": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 60}}
      }
    },
    "chip": {
      "type": "object", "required": ["kind", "text"], "additionalProperties": false,
      "properties": {"kind": {"enum": ["warning", "info"]}, "text": {"type": "string", "maxLength": 90}}
    },
    "pattern": {
      "type": "object", "required": ["type"],
      "properties": {"type": {"enum": ["tier-strip", "tree", "matrix"]}},
      "allOf": [
        {"if": {"properties": {"type": {"const": "tier-strip"}}},
         "then": {"required": ["tiers"], "properties": {"tiers": {"type": "array", "minItems": 2, "maxItems": 5,
           "items": {"type": "object", "required": ["tier", "name"], "properties": {
             "tier": {"enum": ["bronze", "silver", "gold"]}, "name": {"type": "string"}, "note": {"type": "string"}, "icon": {"type": "string"}}}}}}},
        {"if": {"properties": {"type": {"const": "tree"}}},
         "then": {"required": ["lines"], "properties": {"caption": {"type": "string"},
           "lines": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string"}}}}},
        {"if": {"properties": {"type": {"const": "matrix"}}},
         "then": {"required": ["columns", "rows"], "properties": {"caption": {"type": "string"},
           "columns": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"}},
           "rows": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "required": ["name", "cells"],
             "properties": {"name": {"type": "string"}, "cells": {"type": "array", "items": {"enum": ["full", "partial", "none"]}}}}}}}}
      ]
    },
    "panel": {
      "type": "object", "required": ["id", "title", "role"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "title": {"type": "string", "maxLength": 48}, "subtitle": {"type": "string", "maxLength": 80},
        "role": {"enum": ["platform", "storage", "external"]},
        "arrange": {"enum": ["column", "row"]},
        "weights": {"type": "array", "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
        "card_columns": {"type": "integer", "minimum": 1, "maximum": 6},
        "cards": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/card"}},
        "patterns": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/pattern"}},
        "chips": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/chip"}}
      }
    }
  }
}
